#!/bin/sh
# Commit öncesi formatı kontrol eder; dosyaları ve stage içeriğini değiştirmez.

if ! ./gradlew spotlessCheck -q; then
    echo "Spotless kontrolü başarısız oldu, commit iptal edildi."
    echo "Format hataları için ./gradlew spotlessApply çalıştırın, değişiklikleri inceleyip commit'e girecek içeriği yeniden stage edin."
    exit 1
fi

exit 0
