#!/bin/sh
# Java kodunu commit öncesi otomatik formatlar (Spotless) ve formatlanan dosyaları stage'e ekler.

./gradlew spotlessApply -q
if [ $? -ne 0 ]; then
    echo "Spotless formatlama başarısız oldu, commit iptal edildi."
    exit 1
fi

git diff --name-only --diff-filter=ACM | grep '\.java$' | xargs -I{} git add {} 2>/dev/null

exit 0
